{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "title": "Backbone on Kubernetes",
  "description": "Metrics that apply to THIS system. Deliberately no 'recall latency' -- that belongs to a different project. Two of the four originally-requested metrics measure a subsystem that is not running; they are in the collapsed row at the bottom, defined but showing no data.",
  "tags": [
    "backbone",
    "k3s",
    "agent"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      },
      {
        "name": "namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(kube_pod_info, namespace)",
        "current": {
          "text": "backbone",
          "value": "backbone"
        },
        "refresh": 1,
        "includeAll": false,
        "multi": false
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Deploys",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "expr": "changes(kube_deployment_status_observed_generation{namespace=\"$namespace\"}[1m]) > 0",
        "enable": true,
        "iconColor": "blue",
        "titleFormat": "deploy"
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "title": "Availability \u2014 the gateway is a singleton, so down means total outage",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 1,
      "title": "Gateway available",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "kube_deployment_status_replicas_available{namespace=\"$namespace\",deployment=~\".*-gateway\"}",
          "legendFormat": "available",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "UP",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "description": "replicas is permanently 1 (sole SQLite writer + in-process cron). 0 here is a full outage of every channel and all scheduled jobs."
    },
    {
      "id": 2,
      "title": "Gateway restarts (30m)",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "increase(kube_pod_container_status_restarts_total{namespace=\"$namespace\",container=\"gateway\"}[30m])",
          "legendFormat": "restarts",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {},
      "description": "CrashLoopBackOff retries FOREVER -- unlike systemd's StartLimitBurst, which gives up and goes quiet. Nothing escalates this on its own; the alert is the replacement for that behaviour."
    },
    {
      "id": 3,
      "title": "notify-mcp replicas ready",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "kube_deployment_status_replicas_available{namespace=\"$namespace\",deployment=~\".*-notify-mcp\"}",
          "legendFormat": "ready",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      },
      "options": {},
      "description": "The only workload here that scales. Stateless by construction: a fresh MCP server and transport per request."
    },
    {
      "id": 4,
      "title": "notify-mcp uptime",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "max(backbone_uptime_seconds)",
          "legendFormat": "uptime",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 200,
      "title": "Notifications \u2014 how the system talks to its operator",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "panels": []
    },
    {
      "id": 5,
      "title": "Delivery rate by channel",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum by (channel) (rate(backbone_notify_channel_total{outcome=\"ok\"}[5m]))",
          "legendFormat": "{{channel}} ok",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        },
        {
          "expr": "sum by (channel) (rate(backbone_notify_channel_total{outcome=\"fail\"}[5m]))",
          "legendFormat": "{{channel}} fail",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {},
      "description": "Telegram is the primary channel. ntfy failing is expected -- upstream push from this datacenter IP is already rate-limited by a shared-IP quota. Telegram failing is not expected."
    },
    {
      "id": 6,
      "title": "All-channel failures",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "increase(backbone_notify_failed_total[15m])",
          "legendFormat": "both channels failed",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      },
      "options": {},
      "description": "Non-zero means the system is SILENT -- it cannot tell anyone it is broken. This is the one to wake up for."
    },
    {
      "id": 7,
      "title": "Notification fan-out latency",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(backbone_notify_duration_ms_bucket[5m])))",
          "legendFormat": "p50",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(backbone_notify_duration_ms_bucket[5m])))",
          "legendFormat": "p95",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {},
      "description": "Channels fan out concurrently (Promise.all). The stdio original awaited them in series, so a 15s Telegram timeout delayed ntfy by the full 15s."
    },
    {
      "id": 8,
      "title": "Tool errors",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "increase(backbone_tool_errors_total[15m])",
          "legendFormat": "MCP tool errors",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 300,
      "title": "Resources \u2014 the constraints that actually bite",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "panels": []
    },
    {
      "id": 9,
      "title": "Gateway memory vs limit",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 23
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "container_memory_working_set_bytes{namespace=\"$namespace\",container=\"gateway\"}",
          "legendFormat": "working set",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        },
        {
          "expr": "kube_pod_container_resource_limits{namespace=\"$namespace\",container=\"gateway\",resource=\"memory\"}",
          "legendFormat": "limit",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {},
      "description": "The droplet needed a 2GB swapfile in May 2026 because OOM was freezing the host -- no unit set MemoryMax. This limit is what that swapfile was compensating for."
    },
    {
      "id": 10,
      "title": "State volume free",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 23
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "kubelet_volume_stats_available_bytes{namespace=\"$namespace\"} / kubelet_volume_stats_capacity_bytes{namespace=\"$namespace\"}",
          "legendFormat": "{{persistentvolumeclaim}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {},
      "description": "local-path does NOT support online expansion. Running out means a migration, not a resize -- so this needs weeks of runway, not hours."
    },
    {
      "id": 400,
      "title": "Scheduled work \u2014 8 enabled cron jobs, all in-process",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 31
      },
      "panels": []
    },
    {
      "id": 11,
      "title": "Time since last successful CronJob",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "time() - kube_cronjob_status_last_successful_time{namespace=\"$namespace\"}",
          "legendFormat": "{{cronjob}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "s"
        },
        "overrides": []
      },
      "options": {},
      "description": "The 8 hermes cron jobs run INSIDE the gateway process and do not backfill -- if the gateway is down they simply do not fire. These panels cover the k8s CronJobs (rotation, backup)."
    },
    {
      "id": 12,
      "title": "Failed jobs",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "kube_job_status_failed{namespace=\"$namespace\"} > 0",
          "legendFormat": "{{job_name}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 500,
      "title": "Governance gate \u2014 NOT WIRED, panels defined so re-wiring turns them on",
      "type": "row",
      "collapsed": true,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 40
      },
      "panels": [
        {
          "id": 13,
          "title": "Policy-gate decisions (no data - governance gate not wired, see docs/RETENTION.md \u00a75)",
          "type": "timeseries",
          "gridPos": {
            "h": 8,
            "w": 12,
            "x": 0,
            "y": 41
          },
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "targets": [
            {
              "expr": "sum by (decision) (rate(backbone_policy_decisions_total[5m]))",
              "legendFormat": "{{decision}}",
              "refId": "A",
              "datasource": {
                "type": "prometheus",
                "uid": "${DS_PROMETHEUS}"
              }
            }
          ],
          "fieldConfig": {
            "defaults": {
              "custom": {}
            },
            "overrides": []
          },
          "options": {},
          "description": "allowed / denied / replayed. packages/governance implements exactly these three outcomes and passes 57 tests, but was taken out of the request path on 2026-05-24 and is imported by nothing at runtime.",
          "transparent": true
        },
        {
          "id": 14,
          "title": "Proposal to approval latency (no data - governance gate not wired)",
          "type": "timeseries",
          "gridPos": {
            "h": 8,
            "w": 12,
            "x": 12,
            "y": 41
          },
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "targets": [
            {
              "expr": "histogram_quantile(0.95, sum by (le) (rate(backbone_proposal_approval_seconds_bucket[1h])))",
              "legendFormat": "p95",
              "refId": "A",
              "datasource": {
                "type": "prometheus",
                "uid": "${DS_PROMETHEUS}"
              }
            }
          ],
          "fieldConfig": {
            "defaults": {
              "custom": {},
              "unit": "s"
            },
            "overrides": []
          },
          "options": {},
          "description": "Requires the proposal state machine. There are no proposals, so there is no latency between their states. Deliberately not shown as a healthy zero.",
          "transparent": true
        }
      ]
    }
  ]
}
