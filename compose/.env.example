# Copy to compose/.env and fill in. Never commit the filled copy --
# .gitignore already excludes it.
#
# Names come from the Phase 0 audit of ~/.hermes/.env. Only the subset the
# containerized stack actually reads is listed; the live host has 38.

# --- required ---------------------------------------------------------------
OPENROUTER_API_KEY=
WEBHOOK_SECRET=
BACKBONE_NTFY_TOPIC=

# --- optional: Telegram is the primary notification channel -----------------
# Without these, notify-mcp still starts and reports readyz "ntfy only".
TELEGRAM_BOT_TOKEN=
TELEGRAM_HOME_CHANNEL=
TELEGRAM_ALLOWED_USERS=

# --- build pin --------------------------------------------------------------
# The upstream ref the gateway image is built from. Phase 0 observed v0.18.0
# (upstream 07e97d2f) on the live host.
HERMES_REF=v0.18.0
