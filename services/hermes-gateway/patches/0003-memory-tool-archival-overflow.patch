index 02315bd072..e3ed94ed32 100644
--- a/tools/memory_tool.py
+++ b/tools/memory_tool.py
@@ -110,6 +110,45 @@ def _drift_error(path: "Path", bak_path: str) -> Dict[str, Any]:
     }
 
 
+# --- archival overflow hook (local patch, see hermes-hybrid-memory/patches) --
+#
+# A memory provider may register a callback that accepts an entry which does
+# not fit the curated char budget and files it in an unbounded, searchable tier
+# instead of rejecting the write. Without a handler registered, behavior is
+# exactly as before: the at-capacity error is returned unchanged.
+#
+# Motivation: returning an error here hands the model a dead end at the precise
+# moment it is trying to remember something. The observed failure mode was that
+# it improvised its own storage (a loose file nothing indexes) and asked the
+# user to arbitrate which memories to delete.
+_OVERFLOW_HANDLER = None
+_ADMISSION_POLICY = None
+
+
+def set_overflow_handler(fn) -> None:
+    """Register the archival-demotion callback, or clear it with None.
+
+    ``fn(target: str, content: str) -> Optional[str]`` returns a short note
+    describing where the entry was filed, or None to decline the demotion.
+    """
+    global _OVERFLOW_HANDLER
+    _OVERFLOW_HANDLER = fn
+
+
+def set_admission_policy(fn) -> None:
+    """Register a predicate deciding what does NOT belong in curated memory.
+
+    ``fn(target: str, content: str) -> bool`` returns True when the entry is
+    changing detail (a dated event, a running count, a profile of some entity)
+    that should go to the searchable tier rather than consume the always-loaded
+    budget. Standing facts return False and are pinned as usual. Requires an
+    overflow handler to have somewhere to route to; without one, everything is
+    admitted exactly as before.
+    """
+    global _ADMISSION_POLICY
+    _ADMISSION_POLICY = fn
+
+
 class MemoryStore:
     """
     Bounded curated memory with file persistence. One instance per AIAgent.
@@ -333,6 +372,58 @@ class MemoryStore:
             return self.user_char_limit
         return self.memory_char_limit
 
+    def _demote(self, target: str, content: str,
+                action: str = "add") -> Optional[Dict[str, Any]]:
+        """File an over-budget entry in the archival tier instead of refusing it.
+
+        Returns a success response when a handler took the entry, or None to
+        fall through to the original at-capacity error (no handler registered,
+        handler declined, or handler raised).
+        """
+        if _OVERFLOW_HANDLER is None:
+            return None
+        try:
+            note = _OVERFLOW_HANDLER(target, content)
+        except Exception as e:
+            logger.debug("overflow handler failed (%s); falling back to error", e)
+            return None
+        if not note:
+            return None
+        if action == "admission":
+            why = ("Curated memory is reserved for standing facts, and this reads "
+                   "as changing detail")
+            tail = ""
+        elif action == "replace":
+            why = "Curated memory is at capacity"
+            tail = " The entry you meant to replace was left in place."
+        else:
+            why = "Curated memory is at capacity"
+            tail = ""
+        return {
+            "success": True,
+            "tier": "archival",
+            "message": (
+                f"{note} {why}, so it was filed in long-term memory rather than "
+                f"pinned to the always-loaded block. It stays searchable.{tail}"
+            ),
+        }
+
+    def _route_admission(self, target: str, content: str) -> Optional[Dict[str, Any]]:
+        """Let the provider divert changing detail away from the curated block.
+
+        Returns an archival success response when the policy diverts the entry,
+        or None to admit it into curated memory as usual.
+        """
+        if _ADMISSION_POLICY is None:
+            return None
+        try:
+            if not _ADMISSION_POLICY(target, content):
+                return None
+        except Exception as e:
+            logger.debug("admission policy failed (%s); admitting entry", e)
+            return None
+        return self._demote(target, content, action="admission")
+
     def add(self, target: str, content: str) -> Dict[str, Any]:
         """Append a new entry. Returns error if it would exceed the char limit."""
         content = content.strip()
@@ -360,11 +451,20 @@ class MemoryStore:
             if content in entries:
                 return self._success_response(target, "Entry already exists (no duplicate added).")
 
+            # Changing detail goes to the searchable tier without consuming the
+            # always-loaded budget, whether or not there is room for it today.
+            routed = self._route_admission(target, content)
+            if routed is not None:
+                return routed
+
             # Calculate what the new total would be
             new_entries = entries + [content]
             new_total = len(ENTRY_DELIMITER.join(new_entries))
 
             if new_total > limit:
+                demoted = self._demote(target, content)
+                if demoted is not None:
+                    return demoted
                 current = self._char_count(target)
                 return self._consolidation_failure({
                     "success": False,
@@ -435,6 +535,9 @@ class MemoryStore:
