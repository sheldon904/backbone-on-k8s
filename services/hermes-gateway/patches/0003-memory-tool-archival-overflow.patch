                 current = self._char_count(target)
                 return self._consolidation_failure({
                     "success": False,
@@ -662,19 +765,42 @@ class MemoryStore:
         return resp
 
     def _render_block(self, target: str, entries: List[str]) -> str:
-        """Render a system prompt block with header and usage indicator."""
+        """Render a system prompt block with header and usage indicator.
+
+        The char limit is enforced here as well as on write. Writes are gated,
+        but a hand-edit, a restored backup, or a concurrent session can leave a
+        file above budget, and before this the whole file entered the prompt
+        anyway -- the cap silently did not hold where it actually costs tokens.
+        Over-budget files now truncate on whole entries in file order, and the
+        header says so, so the model knows to search rather than assume the
+        block is complete.
+
+        Truncation stays deterministic from disk bytes (file order, no store
+        lookups), which is what keeps the snapshot stable for a whole session
+        and the prompt prefix cacheable.
+        """
         if not entries:
             return ""
 
         limit = self._char_limit(target)
-        content = ENTRY_DELIMITER.join(entries)
+        kept, dropped, used = [], 0, 0
+        for entry in entries:
+            cost = len(entry) + (len(ENTRY_DELIMITER) if kept else 0)
+            if limit > 0 and used + cost > limit and kept:
+                dropped += 1
+                continue
+            kept.append(entry)
+            used += cost
+
+        content = ENTRY_DELIMITER.join(kept)
         current = len(content)
         pct = min(100, int((current / limit) * 100)) if limit > 0 else 0
-
-        if target == "user":
-            header = f"USER PROFILE (who the user is) [{pct}% — {current:,}/{limit:,} chars]"
-        else:
-            header = f"MEMORY (your personal notes) [{pct}% — {current:,}/{limit:,} chars]"
+        label = ("USER PROFILE (who the user is)" if target == "user"
+                 else "MEMORY (your personal notes)")
+        header = f"{label} [{pct}% — {current:,}/{limit:,} chars]"
+        if dropped:
+            header += (f"\n{dropped} older entr{'y' if dropped == 1 else 'ies'} over budget, "
+                       f"not shown — search memory rather than assuming this is everything.")
 
         separator = "═" * 46
         return f"{separator}\n{header}\n{separator}\n{content}"
